# Copy to the host environment (Render). Do not commit real values.

SECRET_KEY=

# sandbox (default) or production
DWOLLA_ENV=sandbox
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_WEBHOOK_SECRET=

# Existing Brittco platform: skip company onboarding.
# Paste the Dwolla customer URL already created for Brittco Capital Inc.
PLATFORM_MODE=brittco_existing
DWOLLA_MASTER_CUSTOMER_URL=
# Optional verified funding source on that customer. Or add the bank on the ACH page.
DWOLLA_PLATFORM_FUNDING_SOURCE_URL=

# New white-label company (shows the in-app company form):
# PLATFORM_MODE=whitelabel

# dwolla | stripe | manual
# Leave blank to prefer Dwolla when DWOLLA_KEY and DWOLLA_SECRET are set,
# otherwise Stripe when STRIPE_SECRET_KEY is set.
PAYMENTS_PROVIDER=

# Kept so old Stripe rows can still be read. Not used for new pulls when Dwolla is selected.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
